# ==============================================================================
# UNICORE ENVIRONMENT CONFIGURATION
# Copy this file to .env.local to enable live cloud services
# ==============================================================================

# 1. Supabase Cloud Connection (Optional - defaults to offline demo mode)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# 2. Live AI Vision & OCR Engine (Optional - defaults to deterministic engine)
# Provide EITHER Gemini OR OpenAI to enable live multi-modal LLM calls:
GEMINI_API_KEY=your-gemini-api-key
OPENAI_API_KEY=your-openai-api-key
